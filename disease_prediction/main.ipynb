   "source": [
    "def clean_numeric(series):\n",
    "    return pd.to_numeric(series.astype(str).str.replace(r'[^0-9.-]', '', regex=True), errors='coerce')\n",
    "\n",
    "df['Age'] = clean_numeric(df['Age'])\n",
    "df['Annual_Income'] = clean_numeric(df['Annual_Income'])\n",
    "df['Num_of_Loan'] = clean_numeric(df['Num_of_Loan'])\n",
    "df['Num_of_Delayed_Payment'] = clean_numeric(df['Num_of_Delayed_Payment'])\n",
    "df['Changed_Credit_Limit'] = clean_numeric(df['Changed_Credit_Limit'])\n",
    "df['Outstanding_Debt'] = clean_numeric(df['Outstanding_Debt'])\n",
    "df['Amount_invested_monthly'] = clean_numeric(df['Amount_invested_monthly'])\n",
    "df['Monthly_Balance'] = clean_numeric(df['Monthly_Balance'])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "dd6463d8",
   "metadata": {},
   "outputs": [],
   "source": [
    "df['Credit_Target'] = df['Credit_Mix'].apply(lambda x: 1 if str(x).strip() == 'Good' else 0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "cc58f1b2",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Feature Engineering\n",
    "df['Debt_Income_Ratio'] = df['Outstanding_Debt'] / (df['Annual_Income'] + 1e-5)\n",
    "df['Total_Delinquency'] = df['Delay_from_due_date'] + df['Num_of_Delayed_Payment'].fillna(0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "d09c9a2a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Select features for modeling\n",
    "features = [\n",
    "    'Age', 'Annual_Income', 'Monthly_Inhand_Salary', 'Num_Bank_Accounts',\n",
    "    'Num_Credit_Card', 'Interest_Rate', 'Num_of_Loan', 'Delay_from_due_date',\n",
    "    'Num_of_Delayed_Payment', 'Num_Credit_Inquiries', 'Credit_Utilization_Ratio',\n",
    "    'Total_EMI_per_month', 'Amount_invested_monthly', 'Monthly_Balance',\n",
    "    'Debt_Income_Ratio', 'Total_Delinquency']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "8097e2b4",
   "metadata": {},
   "outputs": [],
   "source": [
    "X = df[features].copy()\n",
    "y = df['Credit_Target']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "a89a4bad",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Fill missing values with median\n",
    "X = X.fillna(X.median())"
   ]
